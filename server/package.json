{
  "name": "castlerpg-server",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env src/main.ts",
    "test": "node --test \"test/*.test.ts\"",
    "migrate": "node --env-file-if-exists=.env src/cli.ts migrate",
    "seed": "node --env-file-if-exists=.env src/cli.ts seed",
    "neon:migrate": "node --env-file=.env.neon src/cli.ts migrate",
    "neon:seed": "node --env-file=.env.neon src/cli.ts seed",
    "neon:start": "node --env-file=.env.neon src/main.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@hono/node-server": "^2.1.3",
    "@neondatabase/serverless": "^1.1.0",
    "hono": "^4.13.12",
    "ws": "^8.22.0"
  }
}
