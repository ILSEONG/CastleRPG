# server/.env 로 복사해서 쓴다(.env는 git 제외). 여기에는 자리표시자만 둔다 — 실제 값을 커밋하지 않는다.

# Neon 접속 문자열(sslmode=require). 비우면 개발 모드: server/.data/dev 의 PGlite + 고정 개발 비밀.
DATABASE_URL=
# HS256 서명 비밀. 32바이트 이상 무작위. DATABASE_URL이 있는데 비었거나 32자 미만이면 서버가 시작하지 않는다.
# 만들기: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 허용할 웹 출처(쉼표 목록). 비우면 *. 운영에서는 웹 빌드 출처로 정한다. 예: http://localhost:8060,https://game.example.com
CORS_ORIGINS=
# 기본 8787
PORT=8787
# 1이면 POST /v1/test/age 를 연다(통합 테스트 전용). DATABASE_URL과 같이 있으면 서버가 시작하지 않는다.
ALLOW_TEST_HOOKS=

# (선택) 듣는 주소. 기본: 개발 127.0.0.1, 운영(DATABASE_URL 있음) 0.0.0.0. 고정 개발 비밀(JWT_SECRET 없음)은 루프백에서만.
HOST=
# (선택) 개발 PGlite 위치. 기본 server/.data/dev, "memory"면 메모리(끄면 사라짐)
PGLITE_DIR=

# (선택) 소셜 로그인(Google·Kakao·Naver). ID와 SECRET을 둘 다 주면 그 provider가 켜진다(하나만 주면 서버가 시작하지 않는다).
# provider 콘솔에 등록할 리다이렉트 URI: <PUBLIC_URL>/v1/auth/<google|kakao|naver>/callback
# Google: Cloud Console → OAuth 클라이언트(웹 애플리케이션). Kakao: developers.kakao.com REST API 키(+ Client Secret). Naver: developers.naver.com Client ID/Secret.
OAUTH_GOOGLE_ID=
OAUTH_GOOGLE_SECRET=
OAUTH_KAKAO_ID=
OAUTH_KAKAO_SECRET=
OAUTH_NAVER_ID=
OAUTH_NAVER_SECRET=
# 이 서버의 공개 주소(리다이렉트 URI의 앞부분). 운영(DATABASE_URL)에서 provider를 켰으면 필수. 개발은 비우면 요청의 origin을 쓴다.
PUBLIC_URL=
# (선택) 이 분마다 PUBLIC_URL/v1/health 를 스스로 쳐서 무료 호스팅이 잠들지 않게 한다(Render 15분 규칙). 로컬 개발은 비운다.
KEEP_ALIVE_MIN=
