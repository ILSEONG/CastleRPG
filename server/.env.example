# server/.env 로 복사해서 쓴다(.env는 git 제외). 여기에는 자리표시자만 둔다 — 실제 값을 커밋하지 않는다.

# Neon 접속 문자열(sslmode=require). 비우면 개발 모드: server/.data/dev 의 PGlite + 고정 개발 비밀.
DATABASE_URL=
# HS256 서명 비밀. 32바이트 이상 무작위. DATABASE_URL이 있는데 비어 있으면 서버가 시작하지 않는다.
# 만들기: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 허용할 웹 출처(쉼표 목록). 비우면 *.  예: http://localhost:8060,https://game.example.com
CORS_ORIGINS=
# 기본 8787
PORT=8787
# 1이면 POST /v1/test/age 를 연다(통합 테스트 전용). 운영에서는 비워 둔다.
ALLOW_TEST_HOOKS=

# (선택) 듣는 주소. 기본: 개발 127.0.0.1, 운영(DATABASE_URL 있음) 0.0.0.0
HOST=
# (선택) 개발 PGlite 위치. 기본 server/.data/dev, "memory"면 메모리(끄면 사라짐)
PGLITE_DIR=
